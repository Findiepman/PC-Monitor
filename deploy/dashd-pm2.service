# /etc/systemd/system/dashd-pm2.service
#
# Feeds the "Discord bots" page. dashd can't ask pm2 itself (pm2 belongs to
# your user and dashd's sandbox keeps it out of /home), so this runs as the
# pm2 user and talks to the running pm2 daemon over ~/.pm2/rpc.sock (it never
# starts pm2 itself). Every 10 seconds it writes a filtered list to
# /run/pm2-status/pm2.json: name, status, uptime, CPU, memory, restarts, bot
# account names and the Discord names the bots log in as (read from their pm2
# logs). The dashboard's Start/Restart/Stop buttons and log pane reach it through
# /run/pm2-status/control.sock, which only the dashd user can use (an ACL
# entry; no group membership needed).
# Process environments never leave this process. Log lines do: anything a
# bot prints, tokens included, shows in the dashboard's log pane.
#
# If pm2 runs under another user, change `fin` in all five places: After=,
# User=, Group=, PM2_HOME and the bots.json path. The -accounts
# flag lists the keys of that bots.json as the accounts a process signs in;
# drop it or add more (one -accounts per process).
[Unit]
Description=dashd pm2 helper (Discord bot list, start/stop/restart, logs)
After=pm2-fin.service

[Service]
User=fin
Group=fin
Environment=PM2_HOME=/home/fin/.pm2
ExecStart=/usr/local/bin/dashd pm2-export -out /run/pm2-status/pm2.json -accounts fin-and-co=/home/fin/fin-and-co/bots.json
# /run/pm2-status, readable by dashd. systemd removes it when this stops, so
# the page then says the exporter isn't running instead of showing old data.
# A restart keeps it, so updates don't flash an error on the page.
RuntimeDirectory=pm2-status
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
Restart=always
RestartSec=5
# Keep it out of the bots' way.
Nice=10
MemoryMax=128M

NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
# Only the unix socket to pm2 is needed.
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
